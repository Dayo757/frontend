<div class="p-8 max-w-3xl">
  <div class="flex items-center justify-between mb-6 print:hidden">
    <div>
      <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
        <LinkTo @route="crm.invoices" class="hover:text-indigo-600">Invoices</LinkTo>
        <span>/</span>
        <span class="text-gray-900 dark:text-white">{{@invoice.invoiceNumber}}</span>
      </div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{{@invoice.invoiceNumber}}</h1>
        <Crm::Ui::StatusBadge @colorClass={{@invoice.statusColor}} @label={{@invoice.status}} />
      </div>
    </div>
    <div class="flex gap-2">
      {{#if (eq @invoice.status "draft")}}
        <button type="button" {{on "click" this.markSent}} class="px-3 py-1.5 text-sm text-blue-600 border border-blue-300 rounded-md hover:bg-blue-50">Mark Sent</button>
      {{/if}}
      {{#if (or (eq @invoice.status "sent") (eq @invoice.status "overdue"))}}
        <button type="button" {{on "click" this.markPaid}} class="px-3 py-1.5 text-sm text-green-700 border border-green-300 rounded-md hover:bg-green-50">Mark Paid</button>
      {{/if}}
      <Crm::Ui::InvoicePrintView @invoice={{@invoice}} />
      <LinkTo @route="crm.invoices.edit" @model={{@invoice.id}} class="px-3 py-1.5 text-sm border border-gray-300 text-gray-700 dark:text-gray-300 dark:border-gray-600 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700">Edit</LinkTo>
      <button type="button" {{on "click" this.handleDelete}} class="px-3 py-1.5 text-sm text-red-600 border border-red-200 rounded-md hover:bg-red-50">Delete</button>
    </div>
  </div>

  {{! Invoice body (visible on screen + in print via InvoicePrintView) }}
  <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-8 print:hidden">
    <div class="grid grid-cols-2 gap-8 mb-6 text-sm">
      <div>
        {{#if @invoice.client.id}}
          <p class="text-gray-500 text-xs uppercase font-medium mb-1">Bill To</p>
          <p class="font-semibold text-gray-900 dark:text-white">{{@invoice.client.fullName}}</p>
          {{#if @invoice.client.company}}<p class="text-gray-600 dark:text-gray-300">{{@invoice.client.company}}</p>{{/if}}
          {{#if @invoice.client.email}}<p class="text-gray-600 dark:text-gray-300">{{@invoice.client.email}}</p>{{/if}}
        {{/if}}
      </div>
      <div class="text-right text-sm space-y-1">
        {{#if @invoice.issueDate}}<p><span class="text-gray-500">Issue Date:</span> <span class="text-gray-900 dark:text-white">{{date-format @invoice.issueDate format="PP"}}</span></p>{{/if}}
        {{#if @invoice.dueDate}}<p class="{{if @invoice.isOverdue "text-red-600 font-medium" ""}}"><span class="text-gray-500">Due Date:</span> {{date-format @invoice.dueDate format="PP"}}</p>{{/if}}
        {{#if @invoice.event.id}}<p><span class="text-gray-500">Event:</span> <LinkTo @route="crm.events.show" @model={{@invoice.event.id}} class="text-indigo-600">{{@invoice.event.name}}</LinkTo></p>{{/if}}
      </div>
    </div>

    <table class="w-full text-sm mb-6">
      <thead>
        <tr class="border-b-2 border-gray-200 dark:border-gray-600">
          <th class="pb-2 text-left font-semibold text-gray-700 dark:text-gray-300">Description</th>
          <th class="pb-2 text-center font-semibold text-gray-700 dark:text-gray-300 w-20">Qty</th>
          <th class="pb-2 text-right font-semibold text-gray-700 dark:text-gray-300 w-32">Unit Price</th>
          <th class="pb-2 text-right font-semibold text-gray-700 dark:text-gray-300 w-32">Amount</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
        {{#each @invoice.lineItems as |item|}}
          <tr>
            <td class="py-3 text-gray-900 dark:text-white">{{item.description}}</td>
            <td class="py-3 text-center text-gray-600 dark:text-gray-300">{{item.quantity}}</td>
            <td class="py-3 text-right text-gray-600 dark:text-gray-300">{{format-currency item.unitPrice}}</td>
            <td class="py-3 text-right font-medium text-gray-900 dark:text-white">{{format-currency item.lineTotal}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="border-t border-gray-200 dark:border-gray-600 pt-4 space-y-1 text-sm">
      <div class="flex justify-between text-gray-600 dark:text-gray-300"><span>Subtotal</span><span>{{format-currency @invoice.subtotal}}</span></div>
      {{#if @invoice.taxRate}}<div class="flex justify-between text-gray-600 dark:text-gray-300"><span>Tax ({{@invoice.taxRate}}%)</span><span>{{format-currency @invoice.taxAmount}}</span></div>{{/if}}
      {{#if @invoice.discountAmount}}<div class="flex justify-between text-gray-600 dark:text-gray-300"><span>Discount</span><span class="text-red-500">-{{format-currency @invoice.discountAmount}}</span></div>{{/if}}
      <div class="flex justify-between text-lg font-bold text-gray-900 dark:text-white border-t border-gray-200 dark:border-gray-600 pt-2"><span>Total</span><span>{{format-currency @invoice.total}}</span></div>
    </div>

    {{#if @invoice.notes}}
      <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700 text-sm text-gray-600 dark:text-gray-300">
        <p class="font-medium text-gray-700 dark:text-gray-200 mb-1">Notes / Payment Terms</p>
        <p>{{@invoice.notes}}</p>
      </div>
    {{/if}}
  </div>
</div>
