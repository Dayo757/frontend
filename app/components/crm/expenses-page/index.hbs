<div class="p-8">
  <Crm::Ui::SectionHeader @title="Expenses">
    <:action>
      <LinkTo @route="crm.expenses.new" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 transition-colors">
        + Log Expense
      </LinkTo>
    </:action>
  </Crm::Ui::SectionHeader>

  <div class="flex gap-3 mb-4">
    <select value={{this.eventFilter}} {{on "change" (fn (mut this.eventFilter) value="target.value")}}
      class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
      <option value="">All Events</option>
      {{#each @model.events as |event|}}
        <option value={{event.id}}>{{event.name}}</option>
      {{/each}}
    </select>
    <select value={{this.categoryFilter}} {{on "change" (fn (mut this.categoryFilter) value="target.value")}}
      class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
      <option value="">All Categories</option>
      <option value="venue">Venue</option>
      <option value="catering">Catering</option>
      <option value="decor">Decor</option>
      <option value="entertainment">Entertainment</option>
      <option value="equipment">Equipment</option>
      <option value="travel">Travel</option>
      <option value="staffing">Staffing</option>
      <option value="other">Other</option>
    </select>
  </div>

  {{#if this.filteredExpenses.length}}
    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-900">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          {{#each this.filteredExpenses as |expense|}}
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="px-6 py-4 text-sm text-gray-900 dark:text-white">{{expense.description}}</td>
              <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-300">
                {{#if expense.event.id}}
                  <LinkTo @route="crm.events.show" @model={{expense.event.id}} class="text-indigo-600 hover:text-indigo-700">{{expense.event.name}}</LinkTo>
                {{else}}—{{/if}}
              </td>
              <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-300">{{expense.categoryLabel}}</td>
              <td class="px-6 py-4 text-sm font-medium text-gray-900 dark:text-white">{{format-currency expense.amount}}</td>
              <td class="px-6 py-4">
                {{#if expense.isPaid}}
                  <span class="text-xs text-green-600 font-medium">Paid</span>
                {{else}}
                  <span class="text-xs text-yellow-600 font-medium">Unpaid</span>
                {{/if}}
              </td>
              <td class="px-6 py-4 text-sm text-gray-400">
                {{#if expense.createdAt}}{{date-format expense.createdAt format="PP"}}{{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
        <tfoot class="bg-gray-50 dark:bg-gray-900">
          <tr>
            <td colspan="3" class="px-6 py-3 text-sm font-semibold text-gray-700 dark:text-gray-300 text-right">Total</td>
            <td class="px-6 py-3 text-sm font-bold text-gray-900 dark:text-white">{{format-currency this.totalFiltered}}</td>
            <td colspan="2"></td>
          </tr>
        </tfoot>
      </table>
    </div>
  {{else}}
    <Crm::Ui::EmptyState @title="No expenses yet" @description="Log expenses for your events to track costs.">
      <:action>
        <LinkTo @route="crm.expenses.new" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700">
          + Log Expense
        </LinkTo>
      </:action>
    </Crm::Ui::EmptyState>
  {{/if}}
</div>
