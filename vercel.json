{
  "buildCommand": "npm run tailwind:build && npm run build:ember",
  "installCommand": "npm install --no-fund --no-audit --legacy-peer-deps",
  "outputDirectory": "dist",
  "nodeVersion": "20.x",
  "redirects": [
    { "source": "/", "destination": "/crm/dashboard" }
  ],
  "rewrites": [
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/([a-fA-F0-9]{20}).(svg|jpg|png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31556952, immutable" }]
    }
  ]
}
